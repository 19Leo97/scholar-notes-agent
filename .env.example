# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GOOGLE_API_KEY=
# Required to use Gemini: free-tier Gemini may use your data for training, so the
# agent refuses to start with Gemini unless you confirm you are on a PAID plan.
GEMINI_PAID_TIER=false
TAVILY_API_KEY=            # optional; falls back to DuckDuckGo
SEMANTIC_SCHOLAR_API_KEY=  # optional; raises rate limits
CONTACT_EMAIL=             # optional; used for the polite pool of OpenAlex/Crossref
